# Dependencies
node_modules/

# Environment / secrets
.env
.env.*
!.env.example

# Runtime data - server rewrites these; keep them out of version control.
# products.json is checked in as seed data; the rest is runtime-only.
backend/data/wallet.json
backend/data/users.json
backend/uploads/*
!backend/uploads/.gitkeep

# Logs
*.log
npm-debug.log*


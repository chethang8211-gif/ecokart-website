# Copy this file to .env and adjust as needed. Never commit .env.
# Everything here is OPTIONAL for local dev - the app runs with no .env at all
# (user accounts are stored in backend/data/users.json, JWT secret is random).

# HTTP port (hosts like Render inject their own PORT)
PORT=3002

# --- Postgres (optional) --------------------------------------------------
# Leave commented to use the local file store. Uncomment + set a real string
# to use Postgres instead. On Render this is provided automatically.
#   local:   postgres://USER:PASSWORD@localhost:5432/ecokart
#   managed: postgres://USER:PASSWORD@HOST:5432/DBNAME
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/ecokart

# Set "true" for managed Postgres (Render/Neon/Supabase) that requires SSL.
# PGSSL=false

# --- Auth ---------------------------------------------------------------
# Signing secret for JWTs. If unset, a random one is generated at startup
# (fine for dev; set a fixed value so tokens survive restarts). Generate:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# JWT_SECRET=replace-me-with-a-long-random-string

# Token lifetime (zeit/ms format)
JWT_EXPIRES_IN=7d

# CORS allowlist for browser calls made directly to this backend.
# "*" = any origin, or a comma-separated list e.g. https://ecokart.netlify.app
CORS_ORIGIN=*
